# Supabase — danielmath-prod 프로젝트 (us-east-1 / Virginia, cloudMasterIT와 분리)
# 런타임 필수: URL + ANON. SERVICE_ROLE은 학습이력 기능(서명 업로드/조회 URL 발급,
# Claude Vision 채점 파이프라인의 스토리지 다운로드)에서 실사용.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API — 학습지 스캔 채점(학습이력/오답노트 기능)에 사용
ANTHROPIC_API_KEY=
# 선택: 채점 모델 오버라이드. 기본값 claude-sonnet-5 (예산 고려). 정확도가
# 더 필요하면 claude-opus-4-8로 바꿀 수 있음.
ANTHROPIC_GRADING_MODEL=
# 선택: 채점 시 reasoning effort. 기본값 high. low/medium/high/xhigh/max 중 선택 —
# 복잡한 워크시트에서 채점이 계속 실패하면 medium으로 낮춰서 테스트해볼 것.
ANTHROPIC_GRADING_EFFORT=

# Resend (선택: 문의 폼 이메일 알림)
RESEND_API_KEY=
INQUIRY_NOTIFY_EMAIL=
